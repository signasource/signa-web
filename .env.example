# Base URL of signa-api, WITHOUT a trailing slash (the API has no /api prefix).
# signa-api must list this app's origin in CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public origin of this app (canonical URLs, sitemap). signa-api PANEL_URL must point here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth *Web* client ID (same one signa-api uses as auth.google.client-id). Enables "Continuar con Google" on /invitacion.
# Add this app's origin to its "Authorized JavaScript origins". Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
